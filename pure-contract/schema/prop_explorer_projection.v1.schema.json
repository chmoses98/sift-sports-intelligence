              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "yes_ask": {
          "oneOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "no_bid": {
          "oneOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "no_ask": {
          "oneOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "quote_probability": {
          "oneOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "market_comparison": {
      "type": "object",
      "required": [
        "schema_version",
        "record_type",
        "research_only",
        "identity",
        "projection_explorer_id",
        "venue",
        "market_ref",
        "listed_at",
        "quoted_at",
        "captured_at",
        "rungs",
        "null_reasons"
      ],
      "additionalProperties": false,
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "schema_version": {
          "const": "prop_explorer_market_comparison.v1"
        },
        "record_type": {
          "const": "market_comparison"
        },
        "research_only": {
          "const": true
        },
        "identity": {
          "type": "object",
          "required": [
            "sport",
            "game_id",
            "player_id",
            "statistic"
          ],
          "additionalProperties": false,
          "properties": {
            "sport": {
              "$ref": "#/$defs/nonempty"
            },
            "game_id": {
              "$ref": "#/$defs/nonempty"
            },
            "player_id": {
              "$ref": "#/$defs/nonempty"
            },
            "statistic": {
              "$ref": "#/$defs/nonempty"
            }
          }
        },
        "projection_explorer_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/nonempty"
            },
            {
              "type": "null"
            }
          ]
        },
        "venue": {
          "$ref": "#/$defs/nonempty"
        },
        "market_ref": {
          "$ref": "#/$defs/nonempty"
        },
        "listed_at": {
          "oneOf": [
            {
              "$ref": "#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "quoted_at": {
          "$ref": "#/$defs/timestamp"
        },
        "captured_at": {
          "$ref": "#/$defs/timestamp"
        },
        "rungs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/rung"
          }
        },
        "null_reasons": {
          "$ref": "#/$defs/null_reasons"
        }
      },
      "description": "Optional, written by the downstream market reader, keyed by the same identity, for side-by-side display only. Carries no model output or recommendation; never feeds a PURE model, its population or its scoring. Kept in its own file."
    }
  }
}
